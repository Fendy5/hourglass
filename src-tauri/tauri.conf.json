{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hourglass",
  "version": "1.1.0",
  "identifier": "com.hourglass.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Hourglass",
        "label": "main",
        "width": 320,
        "height": 500,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "acceptFirstMouse": true
      },
      {
        "title": "Settings",
        "label": "settings",
        "width": 560,
        "height": 420,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "transparent": true,
        "alwaysOnTop": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
